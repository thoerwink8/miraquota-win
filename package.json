{
  "name": "miraquota-win",
  "version": "0.3.1",
  "description": "Mirasim 额度监控（Windows）：独立桌面应用（托盘常驻），Mirasim 关闭时按锚点推算剩余；另含注入 Mirasim 界面的控件形态",
  "type": "module",
  "private": true,
  "main": "app/main.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron .",
    "dev:offline": "electron . --offline",
    "test": "node --test",
    "icons": "node scripts/gen-icon.mjs",
    "once": "node provider/miraquota-provider.mjs --once",
    "provider": "node provider/miraquota-provider.mjs",
    "dist": "node scripts/dist.mjs",
    "postinstall": "node scripts/gen-icon.mjs"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "25.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "@electron/rebuild"
    ]
  },
  "build": {
    "appId": "local.miraquota.win",
    "productName": "MiraQuota",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**",
      "provider/**",
      "widget/**",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "license": "MIT"
}
